# 用法: source ${EMB_ROOT}/env.sh
# 所有落盘路径都重定向到 ${EMB_ROOT}。
# 可选:EMB_STRICT=1 时要求 ${EMB_ROOT} 是独立挂载点且权限为 700(与同机其他项目隔离),否则拒绝加载。
_E="${EMB_ROOT:?请先 export EMB_ROOT=<大容量数据盘上的工作目录>}"
if [ ! -d "$_E" ]; then
  echo "[env.sh] $_E 不存在" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${EMB_STRICT:-0}" = 1 ] && { ! mountpoint -q "$_E" || [ "$(stat -c %a "$_E")" != "700" ]; }; then
  echo "[env.sh] $_E 未挂载或权限不是 700,拒绝加载" >&2
  return 1 2>/dev/null || exit 1
fi
umask 077

export HOME=$_E/home
export XDG_CONFIG_HOME=$HOME/.config XDG_DATA_HOME=$HOME/.local/share
export XDG_CACHE_HOME=$_E/cache
export TMPDIR=$_E/tmp TMUX_TMPDIR=$_E/tmp
export PYTHONNOUSERSITE=1

# Hugging Face / LeRobot
export HF_HOME=$_E/cache/huggingface
export HF_DATASETS_CACHE=$HF_HOME/datasets
export HF_LEROBOT_HOME=$_E/cache/lerobot
export HF_ENDPOINT=https://huggingface.co
export HF_HUB_DISABLE_TELEMETRY=1

# pip / conda / torch / 编译缓存
export PIP_CACHE_DIR=$_E/cache/pip
export CONDA_PKGS_DIRS=$_E/cache/conda-pkgs
export TORCH_HOME=$_E/cache/torch
export TRITON_CACHE_DIR=$_E/cache/triton
export TORCHINDUCTOR_CACHE_DIR=$_E/cache/inductor
export CUDA_CACHE_PATH=$_E/cache/nv
export MPLCONFIGDIR=$_E/cache/matplotlib
export __GL_SHADER_DISK_CACHE_PATH=$_E/cache/glshader

# 无头渲染:只用系统 NVIDIA 的 EGL 驱动(防止 conda 内的 libglvnd 找不到它)
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json

# 可选代理:按需设置 HTTPS_PROXY / NO_PROXY(本仓库不提供具体地址)

# Miniforge(装好后才存在;不做 conda init)
if [ -f $_E/miniforge3/etc/profile.d/conda.sh ]; then
  . $_E/miniforge3/etc/profile.d/conda.sh
fi
